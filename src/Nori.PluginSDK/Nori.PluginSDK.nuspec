<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Nori.PluginSDK</id>
    <version>$version$</version>
    <title>Nori Plugin SDK</title>
    <authors>FuturumTech</authors>
    <description>Compile-time contracts for Nori Desktop Plugin API 2.0.</description>
    <repository type="git" url="https://github.com/FuturumTech/Nori.PluginSDK" />
    <readme>README.md</readme>
    <dependencies>
      <group targetFramework="net10.0" />
    </dependencies>
    <references>
      <group targetFramework="net10.0">
        <reference file="Nori.PluginRuntime.dll" />
      </group>
    </references>
  </metadata>
  <files>
    <file src="bin/$configuration$/net10.0/Nori.PluginRuntime.dll" target="ref/net10.0" />
    <file src="../../README.md" target="" />
  </files>
</package>
