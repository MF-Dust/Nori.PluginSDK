<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Nori.PluginRuntime</RootNamespace>
    <AssemblyName>Nori.PluginRuntime</AssemblyName>
    <PackageId>Nori.PluginSDK</PackageId>
    <Version>2.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Description>Compile-time contracts for Nori Desktop Plugin API 2.0.</Description>
    <Authors>FuturumTech</Authors>
    <RepositoryUrl>https://github.com/FuturumTech/Nori.PluginSDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- The host supplies Nori.PluginRuntime at runtime. The NuGet package is compile-time only. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>Nori.PluginSDK.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NuspecProperties>version=$(Version);configuration=$(Configuration)</NuspecProperties>
  </PropertyGroup>
</Project>
