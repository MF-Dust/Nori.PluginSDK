<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Nori.PluginRuntime</RootNamespace>
    <AssemblyName>Nori.PluginRuntime</AssemblyName>
    <PackageId>Nori.PluginSDK</PackageId>
    <Version>2.4.1</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>2.4.1.0</FileVersion>
    <Description>Compile-time contracts for Nori Desktop Plugin API 2.4.</Description>
    <Authors>FuturumTech</Authors>
    <RepositoryUrl>https://github.com/MF-Dust/Nori.PluginSDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NU5131 is a known NuGet/MSBuild false positive for intentional ref-only packages. -->
    <NoWarn>$(NoWarn);1591;NU5131</NoWarn>
    <BuildOutputTargetFolder>ref</BuildOutputTargetFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      IPluginPage exposes Avalonia.Controls.Control. Nori Desktop shares its own Avalonia 12.1.1 assemblies with
      plugins, so consumers only receive compile-time Avalonia assets and must not ship Avalonia in a .noripack.
    -->
    <PackageReference Include="Avalonia" Version="12.1.1" PrivateAssets="runtime;native;build;buildTransitive;analyzers;contentfiles" />
    <!--
      IPluginChatProviderContribution exposes Microsoft.Extensions.AI.IChatClient. Nori Desktop shares its own
      Microsoft.Extensions.AI.Abstractions assembly, so consumers only receive compile-time assets.
    -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" PrivateAssets="runtime;native;build;buildTransitive;analyzers;contentfiles" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nori Desktop owns the runtime contract assembly. Pack it only under ref/net10.0. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
