<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Nori.PluginRuntime</RootNamespace>
    <AssemblyName>Nori.PluginRuntime</AssemblyName>
    <PackageId>Nori.PluginSDK</PackageId>
    <Version>2.2.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Description>Compile-time contracts for Nori Desktop Plugin API 2.0.</Description>
    <Authors>FuturumTech</Authors>
    <RepositoryUrl>https://github.com/MF-Dust/Nori.PluginSDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NU5131 is a known NuGet/MSBuild false positive for intentional ref-only packages. -->
    <NoWarn>$(NoWarn);1591;NU5131</NoWarn>
    <BuildOutputTargetFolder>ref</BuildOutputTargetFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nori Desktop owns the runtime contract assembly. Pack it only under ref/net10.0. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
